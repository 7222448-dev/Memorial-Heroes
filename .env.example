# ─── Шаблон змінних оточення ────────────────────────────────────
# Скопіюйте у .env (для локальної розробки) або встановіть як
# Variables у дашборді Railway / Render.
# Файл .env НЕ комітити у git — він уже у .gitignore.

# Порт для локального запуску. На Railway порт виставляється автоматично.
PORT=3000

# Середовище: production вмикає secure-cookie та інші захисти.
NODE_ENV=production

# Секрет сесій. КРИТИЧНО згенерувати свій випадковий рядок (>= 32 символи).
# Швидкий спосіб згенерувати у PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Або у cmd:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=замініть-на-довгий-випадковий-рядок-щонайменше-32-символи

# Окремий секрет для CSRF-токенів. Можна залишити порожнім —
# тоді використовуватиметься SESSION_SECRET. Краще згенерувати окремий.
CSRF_SECRET=

# Скільки щоденних бекапів зберігати у db/backups/ (за замовчуванням 14).
# Якщо деплоїте без Volume — бекапи все одно зникнуть при рестарті,
# тож значення некритичне.
BACKUP_KEEP=14
